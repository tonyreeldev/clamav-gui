{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClamAV GUI",
  "version": "1.0.8",
  "identifier": "com.clamavgui.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClamAV GUI",
        "width": 1300,
        "height": 900,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "publisher": "ClamAV GUI",
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "assets/icon-variants/*.png": "icons/",
      "assets/i18n/*.json": "i18n/"
    },
    "windows": {
      "nsis": {
        "compression": "zlib",
        "installMode": "both",
        "sidebarImage": "assets/sidebar-image.bmp",
        "headerImage": "assets/header-image.bmp",
        "installerIcon": "assets/installer.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
